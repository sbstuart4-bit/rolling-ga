# Rolling GA environment variables
#
# Copy to `.env.local` for local development overrides, or configure these in your
# hosting provider for a controlled demo deployment.
#
# Never commit real secrets.

# --- Required for hosted production (including demo-only deploys) ---

# External PostgreSQL connection string. Required in production — PGlite fallback is disabled.
DATABASE_URL=postgresql://user:password@host:5432/rollingga

# Alternate name accepted by the app if you prefer a project-specific variable.
# ROLLING_GA_DATABASE_URL=postgresql://user:password@host:5432/rollingga

# Signs session cookies and other HMAC-protected tokens. Minimum 16 characters.
ROLLING_GA_SESSION_SECRET=replace-with-a-long-random-secret

# --- Hosted demo-only controls ---

# Full demo board: root `/` opens the board, hosted persona gate, simulated clock, guided demo.
# ROLLING_GA_DEMO=1

# Public marketing guided demo on rollingga.com — enables the homepage "Experience the Demo"
# CTA without redirecting anonymous `/` visitors to the demo board. Requires seeded demo data.
# ROLLING_GA_PUBLIC_GUIDED_DEMO=1

# Required when ROLLING_GA_DEMO=1 in production. Gates passwordless persona login on /demo.
# Not required for ROLLING_GA_PUBLIC_GUIDED_DEMO-only marketing hosts.
# Share https://your-host/demo?access=<this-secret> with authorized walkthrough participants.
# ROLLING_GA_DEMO_BOARD_SECRET=replace-with-a-long-random-demo-board-secret

# --- Local development (optional) ---

# PGlite cluster directory when DATABASE_URL is unset locally. Default: data/pg
# ROLLING_GA_PGLITE_DIR=data/pg

# --- Database maintenance (optional) ---

# Allows demo seed against a production database. Do not enable on public hosts.
# ROLLING_GA_ALLOW_DEMO_SEED=1

# --- Pilot inquiry form (optional until /pilot email delivery is enabled) ---

# Resend API key — server-side only. Never expose to the browser.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rolling GA inbox that receives pilot inquiries.
# PILOT_INBOX=pilots@yourdomain.com

# Verified Resend sender for pilot inquiry emails.
# PILOT_FROM_EMAIL=Rolling GA <pilots@yourdomain.com>
